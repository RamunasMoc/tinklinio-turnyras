# Duomenų bazė (PostgreSQL)
# Vietiniam kūrimui: postgresql://postgres:password@localhost:5432/turnyras
# Railway/Supabase: kopijuoti iš dashboard
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/turnyras"

# NextAuth — generuoti: openssl rand -base64 32
NEXTAUTH_SECRET="PAKEISK_SITA_ILGU_ATSITIKTINIU_TEKSTU"
NEXTAUTH_URL="http://localhost:3000"

# Produkcijai:
# NEXTAUTH_URL="https://jusu-domenas.lt"
